# Public Supabase values (safe to expose in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never use NEXT_PUBLIC_ for any value below.
APP_ORIGIN=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
FO_TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
# Remain false until the verification procedure in docs/deployment.md passes.
FO_HTTPS_CALLBACK_VERIFIED=false
FO_AUTOMATION_VERIFIED=false
# Optional local-only legacy Fo testing; do not configure on Vercel.
FO_DEV_ENABLED=false
FO_DEV_PASSWORD=
